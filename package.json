{
  "name": "gitdog",
  "version": "0.2.1",
  "description": "Manage Gitdog projects, GitHub automation and API keys from your terminal",
  "type": "module",
  "bin": {
    "gitdog": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyodotdev/gitdog-cli.git"
  },
  "homepage": "https://gitdog.dev",
  "bugs": {
    "url": "https://github.com/hyodotdev/gitdog-cli/issues"
  },
  "license": "UNLICENSED",
  "keywords": [
    "gitdog",
    "github",
    "cli",
    "automation",
    "ai"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun run build && node --test test/*.test.mjs",
    "test:dev": "bun run build && node scripts/test-dev.mjs",
    "dev": "bun src/cli.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
