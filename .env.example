# Convex
# Production and preview deploys require the exact public HTTPS origin without a trailing slash.
VITE_CONVEX_URL=

# AI generation (backend Convex environment variables; never VITE_ prefixed)
# Choose api-key or federation. In federation mode, leave ANTHROPIC_API_KEY unset.
ANTHROPIC_AUTH_MODE=api-key
ANTHROPIC_API_KEY=
# Federation IDs differ between dev and prod. Signing uses Convex-managed
# JWT_PRIVATE_KEY/JWKS; never copy the signing private key into local env files.
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
# Must exactly match the approved rule. Default is inference-only; the current
# Console only offers workspace:developer, which requires operator approval.
ANTHROPIC_FEDERATION_SCOPE=workspace:inference
OPENAI_API_KEY=
# Default: Claude first, then OpenAI on exhausted credit/spend limit.
# Claude is permanently disabled from 2027-01-18 00:00 Asia/Seoul.
AI_GENERATION_ROUTE=claude-openai

# GitHub App (Frontend - Vite build-time env var)
# Defaults: gitdogbot-dev in development, gitdogbot in production
VITE_GITHUB_APP_SLUG=

# Lemon Squeezy (Backend - Convex env vars)
LS_API_KEY=
LS_STORE_ID=
LS_WEBHOOK_SECRET=
# Must be false in production; true is for isolated local/test deployments only.
LS_TEST_MODE=false
# Immutable HMAC key retained for settlement fingerprint version 1 (minimum 32 UTF-8 bytes).
# Never rotate it in place; the deployment workflow rejects a key that differs
# from the non-secret attestation pinned alongside production settlement data.
LS_SETTLEMENT_FINGERPRINT_SECRET_V1=
LS_PRO_VARIANT_ID=
LS_TOKEN_PACK_SMALL_VARIANT_ID=
LS_TOKEN_PACK_LARGE_VARIANT_ID=

# GitHub App (Backend - Convex env vars)
# Must match this deployment's VITE_GITHUB_APP_SLUG. A missing or invalid value
# disables bot mention and bot-authorship recognition.
GITHUB_APP_SLUG=gitdogbot-dev
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Gemini is retired. No Google AI credentials are used.

# Site URL (Backend - Convex env vars)
# Production requires the exact public HTTPS origin without a trailing slash.
SITE_URL=http://localhost:5173
